@page
@model SkillBridge.Backend.Pages.Darren.Admin.Lessons.IndexModel
@{
    ViewData["Title"] = "Darren - 02 Manage lessons";
}

<div class="container-fluid py-4">
    <div class="row gx-5">
        <!-- Admin Left Sidebar with Clear Gap -->
        <div class="col-lg-2 col-md-3 border-end pe-4">
            <div class="text-uppercase text-muted fw-bold small mb-2">Workspace</div>
            <ul class="nav flex-column mb-4 list-unstyled">
                <li class="mb-2"><a href="#" class="text-decoration-none text-dark">Overview</a></li>
                <li class="mb-2"><a href="#" class="text-decoration-none text-dark">Users</a></li>
                <li class="mb-2"><a href="#" class="text-decoration-none text-dark">Courses</a></li>
                <li class="mb-2"><a href="#"
                                        class="text-decoration-none fw-bold text-dark bg-light rounded px-2 py-1 d-block">Lessons</a>
                </li>
                <li class="mb-2"><a href="#" class="text-decoration-none text-dark">Resources</a></li>
                <li class="mb-2"><a href="#" class="text-decoration-none text-dark">Quizzes</a></li>
                <li class="mb-2"><a href="#" class="text-decoration-none text-dark">Questions</a></li>
                <li class="mb-2"><a href="#" class="text-decoration-none text-dark">Forum</a></li>
            </ul>

            <div class="text-uppercase text-muted fw-bold small mb-2">Preview</div>
            <ul class="nav flex-column list-unstyled">
                <li><a href="#" class="text-decoration-none text-dark">Open learner site</a></li>
            </ul>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-10 col-md-9 ps-lg-4">
            <!-- Clean Breadcrumb -->
            <div class="text-muted small mb-3">
                <span>Admin</span> <span class="mx-1">&gt;</span> <span class="text-dark fw-semibold">Lessons</span>
            </div>

            <!-- Header & Action Buttons on Same Level -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Lessons</h2>
                    <p class="text-muted small mb-0">Write, order and maintain every course lesson.</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-page="Edit" class="btn btn-dark fw-bold px-3 py-2 text-nowrap">Create lesson</a>
                    <a href="#" class="btn btn-outline-secondary fw-bold px-3 py-2 text-nowrap">Manage resources</a>
                </div>
            </div>

            <!-- Filter Bar Card -->
            <div class="card card-body shadow-sm border-0 mb-4 bg-light">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small text-muted fw-bold">Course</label>
                        <select name="CourseFilter" class="form-select form-select-sm">
                            <option value="">All courses</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted fw-bold">Search</label>
                        <input type="text" name="SearchQuery" class="form-control form-control-sm"
                               placeholder="Search lesson title." />
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-dark w-50 fw-bold">Apply filters</button>
                        <a asp-page="Index" class="btn btn-sm btn-outline-secondary w-50 fw-bold text-center">Clear</a>
                    </div>
                </form>
            </div>

            <!-- Lessons Data Table -->
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="py-3 ps-3" style="width: 25%;">Course / order</th>
                                <th class="py-3" style="width: 35%;">Lesson</th>
                                <th class="py-3 text-center" style="width: 10%;">Minutes</th>
                                <th class="py-3 text-center" style="width: 10%;">Resources</th>
                                <th class="py-3 text-center" style="width: 10%;">Progress records</th>
                                <th class="py-3 text-end pe-3" style="width: 10%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Lessons != null && Model.Lessons.Any())
                            {
                                @foreach (var lesson in Model.Lessons)
                                {
                                    <tr>
                                        <td class="ps-3 fw-medium text-nowrap">@lesson.CourseTitle · @lesson.OrderIndex</td>
                                        <td class="fw-bold">@lesson.Title</td>
                                        <td class="text-center">@lesson.DurationMinutes</td>
                                        <td class="text-center">2</td>
                                        <td class="text-center">15</td>
                                        <td class="text-end pe-3 text-nowrap">
                                            <div class="d-inline-flex gap-1 align-items-center">
                                                <a asp-page="/Darren/Lessons/View" asp-route-id="@lesson.Id"
                                                   class="btn btn-sm btn-outline-dark px-2 py-1">Preview</a>
                                                <a asp-page="Edit" asp-route-id="@lesson.Id"
                                                   class="btn btn-sm btn-outline-secondary px-2 py-1">Edit</a>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@lesson.Id"
                                                      class="d-inline m-0 p-0"
                                                      onsubmit="return confirm('Are you sure you want to delete this lesson?');">
                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger px-2 py-1">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <!-- Fallback / Mock row to match design layout -->
                                <tr>
                                    <td class="ps-3 fw-medium text-nowrap">Git Essentials · 1</td>
                                    <td class="fw-bold">Meet Git and your first repository</td>
                                    <td class="text-center">20</td>
                                    <td class="text-center">2</td>
                                    <td class="text-center">15</td>
                                    <td class="text-end pe-3 text-nowrap">
                                        <div class="d-inline-flex gap-1 align-items-center">
                                            <a href="#" class="btn btn-sm btn-outline-dark px-2 py-1">Preview</a>
                                            <a href="#" class="btn btn-sm btn-outline-secondary px-2 py-1">Edit</a>
                                            <form class="d-inline m-0 p-0">
                                                <button type="button"
                                                        class="btn btn-sm btn-danger px-2 py-1">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Footer summary -->
            <div class="d-flex justify-content-between align-items-center mt-3 text-muted small px-1">
                <div>Showing lessons</div>
                <div>Sorted by the current list order</div>
            </div>
        </div>
    </div>
</div>